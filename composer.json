{
  "name": "itmosoft/laravel-payments",
  "description": "Gateway-agnostic payment intents, transactions and webhook event tracking for Laravel applications.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "illuminate/contracts": "^12.0 || ^13.0",
    "illuminate/database": "^12.0 || ^13.0",
    "illuminate/support": "^12.0 || ^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0 || ^11.0",
    "phpunit/phpunit": "^11.0 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "ItmoSoft\\Payments\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ItmoSoft\\Payments\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": ["ItmoSoft\\Payments\\PaymentsServiceProvider"],
      "aliases": {"Payments": "ItmoSoft\\Payments\\Facades\\Payments"}
    }
  },
  "scripts": {"test": "phpunit"},
  "minimum-stability": "stable",
  "prefer-stable": true
}